// doc-ia — process documentation
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
  CLIENT
}

enum HistorialStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum FlowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FlowNodeStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  WAITING_INPUT
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GitProviderKind {
  GITHUB
  GITLAB
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  avatar    String?
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgNode               OrgNode?
  bitacoras             Bitacora[]
  historiales           Historial[]
  historialStepComments HistorialStepComment[]
  apiKeys               ApiKey[]
  accounts              Account[]
  sessions              Session[]
  todos                 Todo[]                 @relation("TodoOwner")
  pushSubscriptions     PushSubscription[]
  repoBindings          RepoBinding[]
  areaMemberships       AreaMember[]
  processVersionsEdited ProcessVersion[]       @relation("ProcessVersionEditor")
  client                Client?                @relation("ClientUsers", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Area {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  processes ProcessArea[]
  members   AreaMember[]
}

model AreaMember {
  areaId    String
  userId    String
  createdAt DateTime @default(now())

  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([areaId, userId])
  @@index([userId])
}

model OrgNode {
  id        String   @id @default(cuid())
  name      String
  title     String?
  parentId  String?
  userId    String?  @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   OrgNode?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgHierarchy")
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Client {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  processes ProcessClient[]
  users     User[]          @relation("ClientUsers")
  todos     Todo[]          @relation("ClientTodos")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#c2664a")

  processes ProcessTag[]
  todos     TodoTag[]
}

model Process {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  parentId    String?
  order       Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Process?  @relation("ProcessHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Process[] @relation("ProcessHierarchy")

  areas          ProcessArea[]
  clients        ProcessClient[]
  tags           ProcessTag[]
  codeBlocks     ProcessCode[]
  versions       ProcessVersion[]
  attachments    Attachment[]
  bitacoras      BitacoraProcess[]
  historiales    Historial[]
  historialSteps HistorialStep[]
  flowDefinitions FlowDefinition[]
  todos          Todo[]
  repoBinding    RepoBinding?
}

model ProcessArea {
  processId String
  areaId    String

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([processId, areaId])
}

model ProcessClient {
  processId String
  clientId  String

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([processId, clientId])
}

model ProcessTag {
  processId String
  tagId     String

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([processId, tagId])
}

model ProcessCode {
  id            String  @id @default(cuid())
  processId     String
  language      String
  path          String?
  cachedCode    String  @db.Text @map("code")
  lastSha       String?
  lastCommitSha String?
  description   String?
  order         Int     @default(0)

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
}

model ProcessVersion {
  id         String   @id @default(cuid())
  processId  String
  version    Int
  data       Json
  note       String?
  editedById String?
  createdAt  DateTime @default(now())

  process  Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  editedBy User?   @relation("ProcessVersionEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([processId, version])
  @@index([editedById])
}

model Attachment {
  id              String   @id @default(cuid())
  processId       String?
  bitacoraId      String?
  historialStepId String?
  filename        String
  path            String
  mimeType        String
  size            Int
  createdAt       DateTime @default(now())

  process       Process?       @relation(fields: [processId], references: [id], onDelete: Cascade)
  bitacora      Bitacora?      @relation(fields: [bitacoraId], references: [id], onDelete: Cascade)
  historialStep HistorialStep? @relation(fields: [historialStepId], references: [id], onDelete: Cascade)
}

model Bitacora {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  version     Int      @default(1)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  processes   BitacoraProcess[]
  versions    BitacoraVersion[]
  attachments Attachment[]
}

model BitacoraProcess {
  bitacoraId String
  processId  String

  bitacora Bitacora @relation(fields: [bitacoraId], references: [id], onDelete: Cascade)
  process  Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@id([bitacoraId, processId])
}

model BitacoraVersion {
  id         String   @id @default(cuid())
  bitacoraId String
  version    Int
  data       Json
  note       String?
  createdAt  DateTime @default(now())

  bitacora Bitacora @relation(fields: [bitacoraId], references: [id], onDelete: Cascade)

  @@unique([bitacoraId, version])
}

model Historial {
  id         String          @id @default(cuid())
  title      String
  processId  String
  userId     String
  startedAt  DateTime?
  finishedAt DateTime?
  status     HistorialStatus @default(PENDING)
  notes      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  process Process         @relation(fields: [processId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
  steps   HistorialStep[]
}

model HistorialStep {
  id          String     @id @default(cuid())
  historialId String
  processId   String
  order       Int
  startedAt   DateTime?
  finishedAt  DateTime?
  status      StepStatus @default(PENDING)
  notes       String?    @db.Text

  historial   Historial              @relation(fields: [historialId], references: [id], onDelete: Cascade)
  process     Process                @relation(fields: [processId], references: [id])
  comments    HistorialStepComment[]
  attachments Attachment[]
}

model HistorialStepComment {
  id        String   @id @default(cuid())
  stepId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  step HistorialStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  hashedKey   String
  userId      String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FlowDefinition {
  id        String   @id @default(cuid())
  processId String
  name      String
  version   Int      @default(1)
  nodes     Json
  edges     Json
  triggers  Json     @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  process    Process         @relation(fields: [processId], references: [id], onDelete: Cascade)
  executions FlowExecution[]

  @@unique([processId, version])
}

model FlowExecution {
  id               String              @id @default(cuid())
  flowDefinitionId String
  status           FlowExecutionStatus @default(PENDING)
  triggeredBy      String
  input            Json?
  output           Json?
  error            String?             @db.Text
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime            @default(now())

  definition FlowDefinition      @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  nodes      FlowNodeExecution[]
}

model FlowNodeExecution {
  id              String         @id @default(cuid())
  flowExecutionId String
  nodeId          String
  nodeType        String
  status          FlowNodeStatus @default(PENDING)
  input           Json?
  output          Json?
  error           String?        @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?

  execution FlowExecution @relation(fields: [flowExecutionId], references: [id], onDelete: Cascade)
}

model Todo {
  id              String     @id @default(cuid())
  ownerId         String
  title           String
  description     String?    @db.Text
  status          TodoStatus @default(PENDING)
  priority        Int        @default(0)
  dueAt           DateTime?
  alarmAt         DateTime?
  alarmSentAt     DateTime?
  rrule           String?
  rruleUntil      DateTime?
  parentTodoId    String?
  processId       String?
  completedAt     DateTime?
  visibleToClient Boolean    @default(false)
  clientId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner       User      @relation("TodoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  process     Process?  @relation(fields: [processId], references: [id], onDelete: SetNull)
  parentTodo  Todo?     @relation("TodoSeries", fields: [parentTodoId], references: [id], onDelete: Cascade)
  occurrences Todo[]    @relation("TodoSeries")
  tags        TodoTag[]
  client      Client?   @relation("ClientTodos", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, dueAt])
  @@index([alarmAt, alarmSentAt])
  @@index([processId])
  @@index([parentTodoId])
  @@index([clientId, visibleToClient, status, dueAt])
}

model TodoTag {
  todoId String
  tagId  String

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([todoId, tagId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RepoBinding {
  id              String          @id @default(cuid())
  processId       String          @unique
  provider        GitProviderKind
  baseUrl         String?
  repoFullName    String
  defaultBranch   String          @default("main")
  basePath        String          @default("")
  webhookId       String?
  webhookSecret   String?
  webhookActive   Boolean         @default(false)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([provider, repoFullName])
}
