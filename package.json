{
  "name": "@devitzperu/kimeku",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Process documentation platform with versioning and team workflows.",
  "author": "devitzperu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devitzperu/kimeku.git"
  },
  "homepage": "https://github.com/devitzperu/kimeku#readme",
  "bugs": {
    "url": "https://github.com/devitzperu/kimeku/issues"
  },
  "bin": {
    "kimeku": "./bin/kimeku.js"
  },
  "files": [
    "bin/",
    "prisma/schema.prisma",
    "prisma/seed.ts",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "build:dist": "next build --webpack && node scripts/copy-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node scripts/with-db.mjs prisma generate",
    "db:migrate": "node scripts/with-db.mjs prisma migrate dev",
    "db:push": "node scripts/with-db.mjs prisma db push",
    "db:studio": "node scripts/with-db.mjs prisma studio",
    "db:seed": "node scripts/with-db.mjs tsx prisma/seed.ts",
    "db:reset": "node scripts/with-db.mjs prisma migrate reset",
    "db:search-init": "node scripts/with-db.mjs node scripts/enable-search.mjs",
    "postinstall": "node bin/postinstall.js",
    "prepublishOnly": "node scripts/copy-standalone.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
